APP_NAME="Hikka Hills"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Where this API is served.
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# No database: nothing is stored except the enquiries log (storage/logs/enquiries-*.log) and the rate-limit counters.
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# ---- The villa ----------------------------------------------------------------------------------------------------
VILLA_NAME="Hikka Hills"
# The public website (the React site), no slash at the end. Emails link to it.
FRONTEND_URL=http://localhost:5173
# Websites allowed to call this API from a browser, comma separated. Add the live site's address(es) when it goes up.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Enquiries ----------------------------------------------------------------------------------------------------
# The owner's inbox (several allowed, comma separated). Empty = enquiries are not switched on: the API answers 503 and
# the website says nothing was sent. Not confirmed by the owner yet.
ENQUIRY_TO=
# Also send the guest a short copy (dates and guests only), with Reply-To set to the owner.
ENQUIRY_SEND_COPY=true
# Keep equal to booking.maxGuests in src/config/site.ts.
ENQUIRY_MAX_GUESTS=12
ENQUIRY_MAX_DAYS_AHEAD=730
ENQUIRY_PER_MINUTE=5
ENQUIRY_PER_DAY=20
# Days of storage/logs/enquiries-*.log to keep (they hold guests' details).
ENQUIRY_LOG_DAYS=30

# ---- Mail ---------------------------------------------------------------------------------------------------------
# `log` writes each email to storage/logs/laravel.log instead of sending it (local development).
# To send through Gmail (as the gifting platform does): MAIL_MAILER=smtp, MAIL_USERNAME = the Gmail address, and
# MAIL_PASSWORD = an app password (16 letters, no spaces) made at https://myaccount.google.com/apppasswords while signed
# in to that account (2-Step Verification must be on). Never the normal Gmail password. MAIL_FROM_ADDRESS must be the
# same Gmail address, or Gmail rewrites it. Any other provider's SMTP host, port, username and password work the same.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
